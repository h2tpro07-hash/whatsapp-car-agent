# --- Supabase ---
# URL du projet (Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé service_role (backend uniquement, NE JAMAIS exposer côté client)
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Clé anon/publishable (Settings > API) : elle est prévue pour être publique,
# utilisée uniquement par le navigateur (page /admin) pour se connecter via Supabase Auth.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Groq (Llama 3) ---
# https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Modèle utilisé (optionnel)
GROQ_MODEL=openai/gpt-oss-20b

# --- Serveur ---
PORT=3000

# --- Multi-garages ---
# UUID du garage utilisé par CE déploiement (voir sql/schema.sql ou
# sql/migrate_v2_multi_tenant.sql, qui affiche cet UUID en NOTICE après exécution).
# Provisoire : tant qu'il n'y a qu'un seul numéro WhatsApp par déploiement,
# tous les messages entrants sont traités pour ce garage.
DEFAULT_GARAGE_ID=00000000-0000-0000-0000-000000000000

# --- Twilio WhatsApp (optionnel) ---
# Compte MAÎTRE (Console Twilio > Account Info) : sert au garage pilote
# (mono-numéro) ET à créer les sous-comptes des garages provisionnés (Phase 2).
# Nécessite un compte payant (carte enregistrée) pour acheter de vrais numéros.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Numéro WhatsApp du garage pilote (sandbox : +14155238886)
TWILIO_WHATSAPP_FROM=+14155238886
# twiml = réponse directe dans le webhook (défaut) | api = envoi via l'API Twilio
REPLY_MODE=twiml
# URL publique du serveur (ngrok / hébergeur) : valide les signatures Twilio,
# sert de webhook aux numéros provisionnés, et pour les retours Stripe Checkout.
PUBLIC_URL=https://xxxx.ngrok-free.app
# true = rejette les requêtes non signées par Twilio (à activer en production)
VALIDATE_TWILIO_SIGNATURE=false

# --- WhatsApp Cloud API / Meta (optionnel, alternative à Twilio) ---
WHATSAPP_VERIFY_TOKEN=mon-token-de-verification
WHATSAPP_TOKEN=EAAxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_API_VERSION=v21.0

# --- Stripe (facturation mensuelle, optionnel tant que non configuré) ---
# https://dashboard.stripe.com/apikeys (clé "secret", commence par sk_test_ en mode test)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# https://dashboard.stripe.com/webhooks (après création du endpoint /stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Product > Price du plan mensuel (Dashboard Stripe > Product catalog)
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

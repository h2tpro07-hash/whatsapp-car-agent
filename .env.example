# --- Supabase ---
# URL du projet (Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé service_role (backend uniquement, NE JAMAIS exposer côté client)
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Groq (Llama 3) ---
# https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Modèle utilisé (optionnel)
GROQ_MODEL=llama-3.1-8b-instant

# --- Serveur ---
PORT=3000

# --- Admin (endpoint /admin/cars) ---
# Chaîne aléatoire de ton choix, à envoyer dans l'en-tête x-admin-key
ADMIN_API_KEY=change-moi-avec-une-chaine-aleatoire

# --- Twilio WhatsApp (optionnel) ---
# Console Twilio > Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Numéro WhatsApp (sandbox : +14155238886)
TWILIO_WHATSAPP_FROM=+14155238886
# twiml = réponse directe dans le webhook (défaut) | api = envoi via l'API Twilio
REPLY_MODE=twiml
# URL publique du serveur (ngrok / hébergeur), utilisée pour valider la signature
PUBLIC_URL=https://xxxx.ngrok-free.app
# true = rejette les requêtes non signées par Twilio (à activer en production)
VALIDATE_TWILIO_SIGNATURE=false

# --- WhatsApp Cloud API / Meta (optionnel, alternative à Twilio) ---
WHATSAPP_VERIFY_TOKEN=mon-token-de-verification
WHATSAPP_TOKEN=EAAxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_API_VERSION=v21.0
